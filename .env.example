# Copy this file to .env before starting Docker Compose.
WATT_REGISTRY_POSTGRES_DB=watt_registry
WATT_REGISTRY_POSTGRES_USER=wattregistry
WATT_REGISTRY_POSTGRES_PASSWORD=replace-with-a-long-random-password
WATT_REGISTRY_DATABASE_URL=postgres://${WATT_REGISTRY_POSTGRES_USER}:${WATT_REGISTRY_POSTGRES_PASSWORD}@postgres:5432/${WATT_REGISTRY_POSTGRES_DB}
WATT_REGISTRY_POSTGRES_PORT=55435
WATT_REGISTRY_PORT=8042
WATT_REGISTRY_REGISTRATION_MODE=manual
WATT_REGISTRY_CREDENTIAL_TTL_SECONDS=0
